{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileTriage",
  "version": "0.1.0",
  "identifier": "de.filetriage.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FileTriage",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Saveroq",
    "copyright": "Copyright 2026 Björn Boldt",
    "category": "Utility",
    "shortDescription": "Inbox Zero for your files",
    "longDescription": "Organize untidy folders quickly and reversibly. Local, without an account, with Recycle Bin and undo.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "FileTriage"
      }
    }
  }
}
